<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WaBiBaBuSy.UI.App"
             xmlns:local="using:WaBiBaBuSy.UI"
             xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
             x:DataType="vm:TrayViewModel"
             RequestedThemeVariant="Dark">
             <!-- Force Dark theme so custom dark backgrounds (#1E1E1E, #2D2D30) match button/text colors -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/BiBaBuColorIcon.ico" ToolTipText="WaBiBaBuSy - Wallpaper Sync"
                     Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open Control Panel" Command="{Binding ShowWindowCommand}"/>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Connect to Server..." Command="{Binding ConnectCommand}"/>
                        <NativeMenuItem Header="Disconnect" Command="{Binding DisconnectCommand}"/>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Settings" Command="{Binding SettingsCommand}"/>
                        <NativeMenuItem Header="Open Log Folder" Command="{Binding OpenLogFolderCommand}"/>
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding VersionText}" IsEnabled="False"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
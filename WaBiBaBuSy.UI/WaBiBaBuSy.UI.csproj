<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\BiBaBuColorIcon.ico</ApplicationIcon>

    <!-- Version Information: Major.Minor.Patch set manually, BuildNumber auto-set from git commit count -->
    <MajorVersion>2</MajorVersion>
    <MinorVersion>6</MinorVersion>
    <PatchVersion>3</PatchVersion>
    <Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
    <AssemblyVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</AssemblyVersion>
    <FileVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</FileVersion>
    <InformationalVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion)+build.$(BuildNumber)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.21">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaBiBaBuSy.Core\WaBiBaBuSy.Core.csproj" />
    <ProjectReference Include="..\WaBiBaBuSy.Models\WaBiBaBuSy.Models.csproj" />
    <ProjectReference Include="..\WaBiBaBuSy.WallpaperEngine\WaBiBaBuSy.WallpaperEngine.csproj" />
    <!-- Build Player.Image as a dependency so CopyPlayerExecutables always finds the output -->
    <ProjectReference Include="..\WaBiBaBuSy.Player.Image\WaBiBaBuSy.Player.Image.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Build Player.D2D as a dependency so CopyPlayerD2DExecutables always finds the output -->
    <ProjectReference Include="..\WaBiBaBuSy.Player.D2D\WaBiBaBuSy.Player.D2D.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!-- Build Updater as a dependency so CopyUpdaterExecutables always finds the output -->
    <ProjectReference Include="..\WaBiBaBuSy.Updater\WaBiBaBuSy.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Auto-set BuildNumber from git commit count (can be overridden via /p:BuildNumber=N) -->
  <Target Name="SetBuildNumber" BeforeTargets="GetAssemblyVersion;GenerateNuspec;BeforeBuild" Condition="'$(BuildNumber)' == ''">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildNumber" />
    </Exec>
    <PropertyGroup>
      <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
      <AssemblyVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</AssemblyVersion>
      <FileVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).$(BuildNumber)</FileVersion>
      <InformationalVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion)+build.$(BuildNumber)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!-- Copy Player.Image executable and dependencies to output directory -->
  <Target Name="CopyPlayerExecutables" AfterTargets="Build">
    <ItemGroup>
      <PlayerImageFiles Include="..\WaBiBaBuSy.Player.Image\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerImageFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Player.Image executable and dependencies to publish directory -->
  <Target Name="CopyPlayerExecutablesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <PlayerImageFilesPublish Include="..\WaBiBaBuSy.Player.Image\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerImageFilesPublish)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Player.D2D executable and dependencies to output directory -->
  <Target Name="CopyPlayerD2DExecutables" AfterTargets="Build">
    <ItemGroup>
      <PlayerD2DFiles Include="..\WaBiBaBuSy.Player.D2D\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerD2DFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Player.D2D executable and dependencies to publish directory -->
  <Target Name="CopyPlayerD2DExecutablesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <PlayerD2DFilesPublish Include="..\WaBiBaBuSy.Player.D2D\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerD2DFilesPublish)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Updater executable to output directory -->
  <Target Name="CopyUpdaterExecutables" AfterTargets="Build">
    <ItemGroup>
      <UpdaterFiles Include="..\WaBiBaBuSy.Updater\bin\$(Configuration)\net9.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Updater executable to publish directory -->
  <Target Name="CopyUpdaterExecutablesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <UpdaterFilesPublish Include="..\WaBiBaBuSy.Updater\bin\$(Configuration)\net9.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFilesPublish)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy FFmpeg binaries if they exist -->
  <Target Name="CopyFFmpegBinaries" AfterTargets="Build">
    <ItemGroup>
      <FFmpegFiles Include="ffmpeg\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('ffmpeg\ffmpeg.exe')" />
  </Target>

  <!-- Copy FFmpeg binaries to publish directory -->
  <Target Name="CopyFFmpegBinariesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <FFmpegFilesPublish Include="ffmpeg\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegFilesPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('ffmpeg\ffmpeg.exe')" />
  </Target>

  <!--
    Move libvlc native DLLs out of the Avalonia previewer shadow-copy scope.
    The shadow copy covers net9.0-windows\ only. Moving to bin\{Config}\vlc-libs\
    keeps the DLLs reachable at runtime via Core.Initialize() while hiding them from
    the Avalonia previewer host's PreloadAssembliesForXaml, which tries to load every
    *.dll it finds (including native Win32 DLLs) and crashes on BadImageFormatException.
  -->
  <Target Name="MoveLibVLCOutsideShadowCopyScope" AfterTargets="CopyPlayerD2DExecutables">
    <ItemGroup>
      <_LibVLCBuildFiles Include="$(OutputPath)libvlc\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibVLCBuildFiles)" DestinationFolder="$(OutputPath)..\vlc-libs\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutputPath)libvlc" Condition="Exists('$(OutputPath)libvlc')" />
  </Target>

  <Target Name="MoveLibVLCOnPublish" AfterTargets="CopyPlayerD2DExecutablesOnPublish">
    <ItemGroup>
      <_LibVLCPublishFiles Include="$(PublishDir)libvlc\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibVLCPublishFiles)" DestinationFolder="$(PublishDir)vlc-libs\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(PublishDir)libvlc" Condition="Exists('$(PublishDir)libvlc')" />
  </Target>

</Project>

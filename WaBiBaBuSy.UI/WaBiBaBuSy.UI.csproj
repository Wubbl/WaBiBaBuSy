<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Version Information -->
    <BuildNumber Condition="'$(BuildNumber)' == ''">1</BuildNumber>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.$(BuildNumber)</AssemblyVersion>
    <FileVersion>2.0.0.$(BuildNumber)</FileVersion>
    <InformationalVersion>2.0.0+build.$(BuildNumber)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.6">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="FFMpegCore" Version="5.3.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaBiBaBuSy.Core\WaBiBaBuSy.Core.csproj" />
    <ProjectReference Include="..\WaBiBaBuSy.Models\WaBiBaBuSy.Models.csproj" />
    <ProjectReference Include="..\WaBiBaBuSy.WallpaperEngine\WaBiBaBuSy.WallpaperEngine.csproj" />
  </ItemGroup>

  <!-- Copy Player.Image executable and dependencies to output directory -->
  <Target Name="CopyPlayerExecutables" AfterTargets="Build">
    <ItemGroup>
      <PlayerImageFiles Include="..\WaBiBaBuSy.Player.Image\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerImageFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy Player.D2D executable and dependencies to output directory -->
  <Target Name="CopyPlayerD2DExecutables" AfterTargets="Build">
    <ItemGroup>
      <PlayerD2DFiles Include="..\WaBiBaBuSy.Player.D2D\bin\$(Configuration)\net9.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerD2DFiles)" DestinationFolder="$(OutputPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Copy FFmpeg binaries if they exist -->
  <Target Name="CopyFFmpegBinaries" AfterTargets="Build">
    <ItemGroup>
      <FFmpegFiles Include="ffmpeg\*.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('ffmpeg\ffmpeg.exe')" />
  </Target>
</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="620"
        x:Class="WaBiBaBuSy.UI.Views.PlaylistDialog"
        x:DataType="vm:PlaylistViewModel"
        Icon="/Assets/BiBaBuColorIcon.ico"
        Title="Playlist / Party Mode" Width="860" Height="620"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Text="Playlist / Party Mode" FontSize="18" FontWeight="Bold"/>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
                <TextBox   Grid.Column="1" Text="{Binding PlaylistName}"/>
                <CheckBox  Grid.Column="2" Content="Loop" IsChecked="{Binding Loop}"/>
                <CheckBox  Grid.Column="3" Content="Shuffle" IsChecked="{Binding Shuffle}"/>
                <TextBlock Grid.Column="4" Text="Default duration (ms)" VerticalAlignment="Center"
                           ToolTip.Tip="Dwell time used for any item that leaves its own duration box empty."/>
                <NumericUpDown Grid.Column="5" Width="120" Minimum="1000" Increment="1000"
                               Value="{Binding DefaultDurationMs}"/>
            </Grid>
            <TextBlock Text="{Binding ShowSummary}" Opacity="0.75" FontSize="12"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Command="{Binding SavePlaylistCommand}"/>
            <Button Content="Start Show" Command="{Binding StartShowCommandCommand}"
                    IsEnabled="{Binding !IsShowRunning}"/>
            <Button Content="Stop Show" Command="{Binding StopShowCommandCommand}"
                    IsEnabled="{Binding IsShowRunning}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Top">
            <Button Content="Add"       Command="{Binding AddItemCommand}"/>
            <Button Content="Edit"      Command="{Binding EditItemCommand}"/>
            <Button Content="Duplicate" Command="{Binding DuplicateItemCommand}"/>
            <Button Content="Remove"    Command="{Binding RemoveItemCommand}"/>
            <Button Content="Up"        Command="{Binding MoveUpCommand}"/>
            <Button Content="Down"      Command="{Binding MoveDownCommand}"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistItemRow">
                    <Grid ColumnDefinitions="*,150" ColumnSpacing="12" Margin="0,6">
                        <!-- Left: name + config detail lines -->
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBox Text="{Binding Name}" Watermark="Item name"/>
                            <TextBlock Text="{Binding SourceSummary}"   Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Animation file (plus extra images) · target height · fit mode"/>
                            <TextBlock Text="{Binding MovementSummary}" Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Movement type · speed · type-specific parameters · modifier flags"/>
                            <TextBlock Text="{Binding TargetSummary}"   Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Distribution mode · how many monitors this item targets (empty selection = all)"/>
                            <TextBlock Text="{Binding VisualsSummary}"  Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="Background mode · pattern grid · color grading"/>
                        </StackPanel>

                        <!-- Right: dwell time + rotation behaviour -->
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Duration (ms)" FontSize="11" Opacity="0.75"/>
                            <TextBox Text="{Binding DurationText}" Watermark="blank = default"
                                     ToolTip.Tip="How long this item plays, in milliseconds. Leave empty to use the playlist default duration."/>
                            <TextBlock Text="{Binding DurationSummary}" FontSize="11" Opacity="0.75"/>
                            <CheckBox Content="Lap-snap" IsChecked="{Binding SnapToLap}" FontSize="11"
                                      ToolTip.Tip="Wait for the current movement lap to finish before switching (Linear without a pattern; otherwise hard-cut)."/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="WaBiBaBuSy.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/BiBaBuColorIcon.ico"
        Title="WaBiBaBuSy - Wallpaper Sync Control"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Bar with Server Controls -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="WaBiBaBuSy" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#0078D4" CornerRadius="3" Padding="8,4">
                        <TextBlock Text="{Binding ServerStatus}" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <!-- Animation Mode Toggle -->
                    <Border Background="#252526" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Animation:" Foreground="#CCCCCC" VerticalAlignment="Center" FontSize="12"/>
                            <ToggleButton IsChecked="{Binding IsCrossScreenMode}" MinWidth="60"/>
                        </StackPanel>
                    </Border>

                    <!-- Animation Controls (visible when enabled) -->
                    <Button Content="Configure..."
                            Command="{Binding ConfigureCrossScreenCommand}"
                            IsVisible="{Binding IsCrossScreenMode}"/>
                    <Button Content="Start Animation"
                            Command="{Binding StartCrossScreenCommand}"
                            IsVisible="{Binding IsCrossScreenMode}"
                            IsEnabled="{Binding !IsCrossScreenRunning}"/>
                    <Button Content="Stop Animation"
                            Command="{Binding StopCrossScreenCommand}"
                            IsVisible="{Binding IsCrossScreenMode}"
                            IsEnabled="{Binding IsCrossScreenRunning}"/>

                    <!-- Standard Wallpaper Controls (visible when cross-screen disabled) -->
                    <Button Content="Add Wallpaper"
                            Command="{Binding AddWallpaperCommand}"
                            IsVisible="{Binding !IsCrossScreenMode}"/>
                    <Button Content="Apply via LibVLC"
                            Command="{Binding ApplyWallpaperToSelectedCommand}"
                            IsVisible="{Binding !IsCrossScreenMode}"/>
                    <Button Content="Apply via direct2d"
                            Command="{Binding ApplyWallpaperViaDirect2DCommand}"
                            IsVisible="{Binding !IsCrossScreenMode}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Split View: Client Graph (Left) | Wallpaper Gallery (Right) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,5,*">

            <!-- Left Panel: Client Network Graph -->
            <Border Grid.Column="0" Background="#1E1E1E" Padding="15">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Network Topology" FontSize="16"
                                   FontWeight="SemiBold" Foreground="White"/>
                        <Border Background="#0078D4" CornerRadius="3" Padding="5,2">
                            <TextBlock Text="{Binding ClientCount, StringFormat='Nodes: {0}'}"
                                       Foreground="White" FontSize="11" FontWeight="Medium"/>
                        </Border>
                        <Button Content="Select all"
                                Command="{Binding SelectAllClientsCommand}"
                                Padding="8,4"
                                FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#252526" CornerRadius="5" Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- GPU Optimization: ClipToBounds reduces overdraw, RenderOptions improves caching -->
                            <Canvas Width="800" Height="400" Background="#1A1A1A" Name="TopologyCanvas"
                                    ClipToBounds="True">
                                <!-- Client nodes will be added programmatically in code-behind -->
                            </Canvas>
                        </ScrollViewer>
                    </Border>

                    <!-- Selected Client Details -->
                    <Border Grid.Row="2"
                            Background="#252526"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,10,0,0"
                            IsVisible="{Binding SelectedClient, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0"
                                       Text="{Binding SelectedClient.DisplayName, StringFormat='Client: {0}'}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0"
                                           Text="Physical Distance (cm):"
                                           Foreground="#CCCCCC"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedClient.PhysicalDistanceCm}"
                                         Width="150"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Content="Update Distance"
                                        Command="{Binding UpdateClientDistanceCommand}"
                                        CommandParameter="{Binding SelectedClient}"
                                        Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Text="Distance from previous client in the chain. Used to calculate animation delay."
                                       Foreground="#888888"
                                       FontSize="10"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#3E3E42"/>

            <!-- Right Panel: Wallpaper Gallery -->
            <Border Grid.Column="2" Background="#1E1E1E" Padding="15">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Wallpaper Gallery" FontSize="16"
                               FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                    <!-- Wallpaper Grid -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Wallpapers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:WallpaperItemViewModel">
                                    <Button Width="180" Height="140"
                                            Margin="5"
                                            CornerRadius="5"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectWallpaperCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Padding="8">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveWallpaperCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="BorderBrush" Value="#555555"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                            </Style>
                                        </Button.Styles>

                                        <Grid RowDefinitions="*,Auto">
                                            <!-- Thumbnail Preview Area -->
                                            <Border Grid.Row="0"
                                                    Background="#404040"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Panel>
                                                    <!-- Show image preview if available -->
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                    <!-- Fallback to type text if no thumbnail -->
                                                    <TextBlock Text="{Binding Type}"
                                                               Foreground="#AAAAAA"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Padding="20"
                                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                </Panel>
                                            </Border>

                                            <!-- Wallpaper Info -->
                                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Resolution}"
                                                               Foreground="#888888"
                                                               FontSize="9"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileSize}"
                                                               Foreground="#888888"
                                                               FontSize="9"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Selected Wallpaper Preview -->
                    <Border Grid.Row="2"
                            Background="#252526"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,0"
                            IsVisible="{Binding SelectedWallpaper, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                            <!-- Preview Image -->
                            <Border Grid.Column="0"
                                    Width="100" Height="75"
                                    Background="#404040"
                                    CornerRadius="3"
                                    Margin="0,0,10,0">
                                <Panel>
                                    <Image Source="{Binding SelectedWallpaper.Thumbnail}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding SelectedWallpaper.Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding SelectedWallpaper.Type}"
                                               Foreground="#AAAAAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               IsVisible="{Binding SelectedWallpaper.Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                </Panel>
                            </Border>

                            <!-- Wallpaper Details -->
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Selected Wallpaper"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock Text="{Binding SelectedWallpaper.Name}"
                                           Foreground="#CCCCCC"
                                           FontSize="11"
                                           FontWeight="Medium"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedWallpaper.Resolution}"
                                               Foreground="#888888"
                                               FontSize="9"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedWallpaper.FileSize}"
                                               Foreground="#888888"
                                               FontSize="9"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedWallpaper.FilePath}"
                                           Foreground="#666666"
                                           FontSize="8"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

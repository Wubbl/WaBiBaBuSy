<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:WaBiBaBuSy.UI.Views"
        xmlns:controls="using:WaBiBaBuSy.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="WaBiBaBuSy.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/BiBaBuColorIcon.ico"
        Title="WaBiBaBuSy - Wallpaper Sync Control"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <views:HexToColorConverter x:Key="HexToColor"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top Bar with Server Controls -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="15,10">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Row 0: Server controls (left) | Composition group (right) -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleServerModeCommand}"
                                Padding="8,4" FontSize="11" VerticalAlignment="Center"
                                IsEnabled="{Binding !IsClientConnected}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="&#9654; Start Server" IsVisible="{Binding !IsServerMode}"/>
                                <TextBlock Text="&#9632; Stop Server" IsVisible="{Binding IsServerMode}"/>
                            </StackPanel>
                        </Button>
                        <Border Background="#00AA44" CornerRadius="3" Padding="8,4" IsVisible="{Binding IsServerMode}">
                            <TextBlock Text="Running" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#0078D4" CornerRadius="3" Padding="6,4" IsVisible="{Binding IsServerMode}">
                            <TextBlock Text="{Binding ServerPort, StringFormat='Port: {0}'}" Foreground="White" FontSize="11"/>
                        </Border>
                        <Border Background="#555555" CornerRadius="3" Padding="6,4" IsVisible="{Binding IsServerMode}">
                            <TextBlock Text="{Binding ConnectedClientCount, StringFormat='Clients: {0}'}" Foreground="White" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Composition Group -->
                    <Border Grid.Column="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
                            CornerRadius="5" Padding="6,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Composition" Foreground="#AAAAAA" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <ComboBox SelectedIndex="{Binding SelectedFitModeIndex}" Width="90"
                                     VerticalAlignment="Center" FontSize="11" Padding="4,2" Height="28">
                                <ComboBoxItem Content="Stretch"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Fit"/>
                                <ComboBoxItem Content="Fill"/>
                            </ComboBox>
                            <Button Content="Apply D2D"
                                    Command="{Binding ApplyWallpaperViaDirect2DCommand}"
                                    Height="28" Padding="8,4" FontSize="11"/>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    BorderBrush="#666666" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding D2dBackgroundColor, Converter={StaticResource HexToColor}}"/>
                                </Border.Background>
                            </Border>
                            <TextBox Text="{Binding D2dBackgroundColor}" Width="68" FontSize="12"
                                     Padding="4,2" Height="28" VerticalAlignment="Center"
                                     TextAlignment="Center" VerticalContentAlignment="Center"/>
                            <CheckBox IsChecked="{Binding IsAutoDetectBackground}" Content="Auto"
                                      FontSize="10" VerticalAlignment="Center" Padding="2,0"/>
                            <Border Width="1" Height="20" Background="#3E3E42" VerticalAlignment="Center"/>
                            <Button Content="Multi Monitor"
                                    Command="{Binding ConfigureCrossScreenCommand}"
                                    Height="28" Padding="8,4" FontSize="11"/>
                            <Button Content="Start"
                                    Command="{Binding StartCrossScreenCommand}"
                                    IsVisible="{Binding HasAnimationConfig}"
                                    Height="28" Padding="8,4" FontSize="11"/>
                            <Button Content="Stop"
                                    Command="{Binding StopCrossScreenCommand}"
                                    IsVisible="{Binding IsCrossScreenRunning}"
                                    Height="28" Padding="8,4" FontSize="11"/>
                            <Border Width="1" Height="20" Background="#3E3E42" VerticalAlignment="Center"/>
                            <Button Content="Playlist..."
                                    Command="{Binding OpenPlaylistCommand}"
                                    Height="28" Padding="8,4" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Client connect controls (left) | Debug group (right) -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding !IsServerMode}">
                        <TextBox Text="{Binding ConnectServerAddress}"
                                 Watermark="Server IP"
                                 Width="120" FontSize="11" Padding="4,3" Height="28"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding !IsClientConnected}"/>
                        <TextBox Text="{Binding ConnectServerPort}"
                                 Watermark="Port"
                                 Width="55" FontSize="11" Padding="4,3" Height="28"
                                 VerticalContentAlignment="Center" TextAlignment="Center"
                                 IsEnabled="{Binding !IsClientConnected}"/>
                        <Button Command="{Binding ConnectToServerCommand}"
                                Padding="8,4" FontSize="11" Height="28"
                                IsEnabled="{Binding !IsConnecting}"
                                IsVisible="{Binding !IsClientConnected}">
                            <TextBlock Text="Connect"/>
                        </Button>
                        <Button Command="{Binding FindServersCommand}"
                                Padding="8,4" FontSize="11" Height="28"
                                IsEnabled="{Binding !IsConnecting}"
                                IsVisible="{Binding !IsClientConnected}"
                                ToolTip.Tip="Browse servers discovered on the local network (mDNS)">
                            <TextBlock Text="Find..."/>
                        </Button>
                        <Button Command="{Binding DisconnectFromServerCommand}"
                                Padding="8,4" FontSize="11" Height="28"
                                IsVisible="{Binding IsClientConnected}">
                            <TextBlock Text="Disconnect"/>
                        </Button>
                        <Border Background="#00AA44" CornerRadius="3" Padding="6,4" IsVisible="{Binding IsClientConnected}">
                            <TextBlock Text="Connected" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#AA4400" CornerRadius="3" Padding="6,4" IsVisible="{Binding IsConnecting}">
                            <TextBlock Text="Connecting..." Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Debug Overlay Group -->
                    <Border Grid.Column="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1"
                            CornerRadius="5" Padding="6,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Debug" Foreground="#AAAAAA" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <CheckBox Content="On" IsChecked="{Binding DebugOverlayEnabled}"
                                      FontSize="10" VerticalAlignment="Center"
                                      ToolTip.Tip="Enable debug overlay (also F11)"/>
                            <CheckBox Content="Path" IsChecked="{Binding DebugShowPath}"
                                      FontSize="10" VerticalAlignment="Center"
                                      ToolTip.Tip="Show A* path waypoints"/>
                            <CheckBox Content="Rects" IsChecked="{Binding DebugShowIconRects}"
                                      FontSize="10" VerticalAlignment="Center"
                                      ToolTip.Tip="Show icon zone rectangles"/>
                            <CheckBox Content="Zones" IsChecked="{Binding DebugShowZoneBands}"
                                      FontSize="10" VerticalAlignment="Center"
                                      ToolTip.Tip="Show zone band outlines"/>
                            <CheckBox Content="Info" IsChecked="{Binding DebugShowInfoPanel}"
                                      FontSize="10" VerticalAlignment="Center"
                                      ToolTip.Tip="Show info panel (FPS, position, etc.)"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Update Notification Bar -->
        <Border Grid.Row="1" Background="#1A3A5C" Padding="10,6"
                IsVisible="{Binding IsUpdateAvailable}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="UPDATE" Foreground="#4FC3F7"
                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}"
                           Foreground="White" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar Grid.Column="2" Value="{Binding UpdateProgressPercent}"
                             Width="120" Height="14" Margin="10,0"
                             VerticalAlignment="Center"
                             IsVisible="{Binding IsUpdateInProgress}"/>
                <Button Grid.Column="3" Content="Download &amp; Apply"
                        Command="{Binding DownloadAndApplyUpdateCommand}"
                        Padding="8,3" FontSize="11" Margin="5,0"
                        IsEnabled="{Binding !IsUpdateInProgress}"/>
                <Button Grid.Column="4" Content="Dismiss"
                        Command="{Binding DismissUpdateCommand}"
                        Padding="8,3" FontSize="11"
                        IsEnabled="{Binding !IsUpdateInProgress}"/>
            </Grid>
        </Border>

        <!-- Main Split View: Client Graph (Left) | Wallpaper Gallery (Right) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,5,*">

            <!-- Left Panel: Client Network Graph -->
            <Border Grid.Column="0" Background="#1E1E1E" Padding="15">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Network Topology" FontSize="16"
                                   FontWeight="SemiBold" Foreground="White"/>
                        <Border Background="#0078D4" CornerRadius="3" Padding="5,2">
                            <TextBlock Text="{Binding ClientCount, StringFormat='Nodes: {0}'}"
                                       Foreground="White" FontSize="11" FontWeight="Medium"/>
                        </Border>
                        <Button Content="Select all"
                                Command="{Binding SelectAllClientsCommand}"
                                Padding="8,4"
                                FontSize="12"/>
                    </StackPanel>

                    <!-- Room layout (seat map): how the ordered node chain is broken into table rows
                         and how the animation path travels between them. Persisted server-side. -->
                    <Border Grid.Row="1" Background="#252526" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Room" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Rows" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <NumericUpDown Value="{Binding RoomRowCount}" Minimum="1" Maximum="8" Increment="1"
                                           Width="95" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Text="Seats / row" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                       IsEnabled="{Binding IsRoomMultiRow}"/>
                            <NumericUpDown Value="{Binding RoomSeatsPerRow}" Minimum="1" Maximum="50" Increment="1"
                                           Width="95" FontSize="11" Margin="0,0,12,0" IsEnabled="{Binding IsRoomMultiRow}"/>
                            <CheckBox IsChecked="{Binding RoomRowsFacing}" Content="Rows face each other"
                                      FontSize="11" Margin="0,0,12,0" IsEnabled="{Binding IsRoomMultiRow}"/>
                            <TextBlock Text="Path" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox SelectedIndex="{Binding RoomTraversalIndex}" Width="110" FontSize="11" Margin="0,0,12,0">
                                <ComboBoxItem Content="Ring (loop)"/>
                                <ComboBoxItem Content="Snake"/>
                                <ComboBoxItem Content="Parallel"/>
                            </ComboBox>
                            <TextBlock Text="Turn gap (cm)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                                       IsEnabled="{Binding IsRoomMultiRow}"/>
                            <NumericUpDown Value="{Binding RoomTurnGapCm}" Minimum="0" Maximum="3000" Increment="10"
                                           Width="105" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SeatMapSummary}" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </Border>

                    <!-- Mixed-refresh-rate info banner (visible only when local monitors disagree) -->
                    <Border Grid.Row="2"
                            Background="#3B2E10"
                            BorderBrush="#A07820"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,8"
                            IsVisible="{Binding HasLocalRefreshRateMismatch}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="&#9888;" Foreground="#FFD080" FontSize="14"
                                       VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocalRefreshRateMismatchWarning}"
                                       Foreground="#FFE0A8" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#1A1A1A" CornerRadius="5" ClipToBounds="True"
                            Name="TopologyBorder">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Canvas Name="TopologyCanvas" Background="#1A1A1A"
                                    ClipToBounds="True">
                                <!-- Client nodes will be added programmatically in code-behind -->
                            </Canvas>
                        </ScrollViewer>
                    </Border>

                    <!-- Animation Controls in Topology Panel -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,5,5,0">
                        <Button Content="Stop Animation"
                                Command="{Binding StopCrossScreenCommand}"
                                Padding="8,4" FontSize="11"
                                IsVisible="{Binding IsCrossScreenRunning}"/>
                        <Button Content="Clear Wallpaper"
                                Command="{Binding ClearAllWallpapersCommand}"
                                Padding="8,4" FontSize="11"
                                IsVisible="{Binding HasActiveRenderer}"/>
                    </StackPanel>

                    <!-- Selected Client Details -->
                    <Border Grid.Row="4"
                            Background="#252526"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,10,0,0"
                            IsVisible="{Binding SelectedClient, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SelectedClient.DisplayName, StringFormat='Client: {0}', FallbackValue='Client:'}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding SelectedClient.Order, StringFormat='Order: {0}', FallbackValue='Order:'}"
                                               Foreground="#AAAAAA" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="&#9650;" FontSize="10" Padding="6,3"
                                            Command="{Binding MoveClientUpCommand}"
                                            ToolTip.Tip="Move up in animation order"/>
                                    <Button Content="&#9660;" FontSize="10" Padding="6,3"
                                            Command="{Binding MoveClientDownCommand}"
                                            ToolTip.Tip="Move down in animation order"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0"
                                           Text="Physical Distance (cm):"
                                           Foreground="#CCCCCC"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SelectedClient.PhysicalDistanceCm, FallbackValue=0}"
                                         Width="150"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Content="Update Distance"
                                        Command="{Binding UpdateClientDistanceCommand}"
                                        CommandParameter="{Binding SelectedClient}"
                                        Margin="10,0,0,0"/>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Distance from previous client in the chain. Used to calculate animation delay."
                                           Foreground="#888888"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Content="Apply via LibVLC"
                                        Command="{Binding ApplyWallpaperToSelectedCommand}"
                                        Padding="8,4" FontSize="11"
                                        VerticalAlignment="Center"/>
                                <Button Content="View Remote Logs"
                                        Command="{Binding FetchClientLogsCommand}"
                                        Padding="8,4" FontSize="11"
                                        IsVisible="{Binding IsServerMode}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Remote Client Log Viewer -->
                    <Border Grid.Row="2"
                            Background="#1A1A2E"
                            BorderBrush="#0078D4"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,5,0,0"
                            IsVisible="{Binding IsClientLogsVisible}"
                            MaxHeight="300">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                <TextBlock Text="Remote Client Logs" Foreground="#0078D4"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Refresh" Command="{Binding FetchClientLogsCommand}"
                                        Padding="6,2" FontSize="10"/>
                                <Button Content="Close" Command="{Binding CloseClientLogsCommand}"
                                        Padding="6,2" FontSize="10"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding RemoteClientLogs}"
                                           Foreground="#CCCCCC"
                                           FontSize="10"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#3E3E42"/>

            <!-- Right Panel: Wallpaper Gallery -->
            <Border Grid.Column="2" Background="#1E1E1E" Padding="15" DragDrop.AllowDrop="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Wallpaper Gallery" FontSize="16"
                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="+ Add"
                                Command="{Binding AddWallpaperCommand}"
                                Padding="10,4" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Wallpaper Grid -->
                    <ScrollViewer Grid.Row="1" Name="GalleryScrollViewer">
                        <ItemsControl ItemsSource="{Binding Wallpapers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:WallpaperItemViewModel">
                                    <Button Width="180" Height="140"
                                            Margin="5"
                                            CornerRadius="5"
                                            Classes.selected="{Binding IsSelected}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectWallpaperCommand}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Padding="8">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Remove"
                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveWallpaperCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                                <Setter Property="BorderBrush" Value="#555555"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#3E3E42"/>
                                            </Style>
                                            <Style Selector="Button.selected">
                                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="Background" Value="#3A4A5E"/>
                                            </Style>
                                        </Button.Styles>

                                        <Grid RowDefinitions="*,Auto">
                                            <!-- Thumbnail Preview Area -->
                                            <Border Grid.Row="0"
                                                    Background="#404040"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch">
                                                <Panel>
                                                    <!-- Show image preview if available -->
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                    <!-- Fallback to type text if no thumbnail -->
                                                    <TextBlock Text="{Binding TypeName}"
                                                               Foreground="#AAAAAA"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Padding="20"
                                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>

                                                    <!-- Type badge (top-right corner) -->
                                                    <Border Background="{Binding TypeBadgeBrush}"
                                                            CornerRadius="3"
                                                            Padding="4,2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,4,4,0">
                                                        <TextBlock Text="{Binding TypeName}"
                                                                   Foreground="White"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Panel>
                                            </Border>

                                            <!-- Wallpaper Info -->
                                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Resolution}"
                                                               Foreground="#888888"
                                                               FontSize="9"
                                                               IsVisible="{Binding HasResolution}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FileSize}"
                                                               Foreground="#888888"
                                                               FontSize="9"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Active Animation Info (shown when no wallpaper selected but animation running) -->
                    <Border Grid.Row="2"
                            Background="#252526"
                            CornerRadius="5"
                            Padding="15"
                            Margin="0,10,0,0"
                            IsVisible="{Binding ShowAnimationInfo}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Active Animation"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#00CC66"/>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="File:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding ActiveAnimationFileName}" Foreground="#CCCCCC" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Mode:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding ActiveDistributionMode}" Foreground="#CCCCCC" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Speed:" Foreground="#888888" FontSize="11"/>
                                    <TextBlock Text="{Binding ActiveAnimationSpeed, StringFormat='{}{0} px/s'}" Foreground="#CCCCCC" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Background:" Foreground="#888888" FontSize="11"/>
                                    <Border Width="12" Height="12" CornerRadius="2" VerticalAlignment="Center"
                                            BorderBrush="#666666" BorderThickness="1">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding ActiveBackgroundColor, Converter={StaticResource HexToColor}}"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding ActiveBackgroundColor}" Foreground="#CCCCCC" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Live view: where the sprite is right now, on the players' shared clock -->
                            <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                                <controls:ScenePreviewControl Height="170"
                                                              Layout="{Binding ActiveLayout}"
                                                              Scene="{Binding ActiveScene}"
                                                              Labels="{Binding ActiveLabels}"
                                                              SpriteImagePath="{Binding ActiveSpriteImagePath}"
                                                              SharedStartUtcMs="{Binding ActiveSharedStartMs}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Selected Wallpaper Preview -->
                    <Border Grid.Row="2"
                            Background="#252526"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,0"
                            IsVisible="{Binding SelectedWallpaper, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto">
                            <!-- Preview Image -->
                            <Border Grid.Column="0"
                                    Width="100" Height="75"
                                    Background="#404040"
                                    CornerRadius="3"
                                    Margin="0,0,10,0">
                                <Panel>
                                    <Image Source="{Binding SelectedWallpaper.Thumbnail}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding SelectedWallpaper.Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    <TextBlock Text="{Binding SelectedWallpaper.Type}"
                                               Foreground="#AAAAAA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               IsVisible="{Binding SelectedWallpaper.Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                </Panel>
                            </Border>

                            <!-- Wallpaper Details -->
                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Selected Wallpaper"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{Binding SelectedWallpaper.TypeBadgeBrush}"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedWallpaper.TypeName}"
                                                   Foreground="White"
                                                   FontSize="8"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedWallpaper.Name}"
                                           Foreground="#CCCCCC"
                                           FontSize="11"
                                           FontWeight="Medium"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SelectedWallpaper.Resolution}"
                                               Foreground="#888888"
                                               FontSize="9"
                                               Margin="0,0,10,0"
                                               IsVisible="{Binding SelectedWallpaper.HasResolution}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedWallpaper.FileSize}"
                                               Foreground="#888888"
                                               FontSize="9"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedWallpaper.FilePath}"
                                           Foreground="#666666"
                                           FontSize="8"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="WaBiBaBuSy.UI.Views.WallpaperMultiSelectDialog"
        x:DataType="vm:WallpaperMultiSelectDialogViewModel"
        Icon="/Assets/BiBaBuColorIcon.ico"
        Title="Select Wallpapers"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:WallpaperMultiSelectDialogViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20" ColumnDefinitions="*,150">
        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="5" Margin="0,0,0,15">
            <TextBlock Text="Select Wallpapers from Gallery" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectionSummary}" FontSize="12" Foreground="#AAAAAA"/>
        </StackPanel>

        <!-- Filters and Search -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Spacing="10">
                <!-- Search Box -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Search:" FontSize="11" Foreground="#AAAAAA"/>
                    <TextBox Text="{Binding SearchQuery}" Watermark="Search by name or path..."/>
                </StackPanel>

                <!-- Filter and Sort Controls -->
                <Grid ColumnDefinitions="Auto,200,Auto,200,Auto,150">
                    <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" FontSize="11"/>
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedFilterMode}" Margin="10,0,20,0">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Animations (Video/GIF)"/>
                        <ComboBoxItem Content="Backgrounds (Images)"/>
                        <ComboBoxItem Content="Videos"/>
                        <ComboBoxItem Content="Images"/>
                        <ComboBoxItem Content="GIFs"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Sort:" VerticalAlignment="Center" FontSize="11"/>
                    <ComboBox Grid.Column="3" SelectedIndex="{Binding SelectedSortMode}" Margin="10,0,20,0">
                        <ComboBoxItem Content="Name (A-Z)"/>
                        <ComboBoxItem Content="Name (Z-A)"/>
                        <ComboBoxItem Content="Size (Large)"/>
                        <ComboBoxItem Content="Type"/>
                    </ComboBox>

                    <CheckBox Grid.Column="4" Content="Select All" IsChecked="{Binding SelectAll}"
                              Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Wallpaper Grid -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1E1E1E" CornerRadius="5" Padding="10">
            <ItemsControl ItemsSource="{Binding FilteredWallpapers}"
                          Background="Transparent" BorderThickness="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WallpaperMultiSelectItem">
                        <Border Background="#2D2D30" CornerRadius="5" Padding="10" Margin="5"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#3E3E42"/>
                                    <Setter Property="BorderBrush" Value="#0078D4"/>
                                </Style>
                            </Border.Styles>

                            <StackPanel Spacing="6" Cursor="Hand">
                                <!-- Thumbnail -->
                                <Border Height="90"
                                        Background="#404040"
                                        CornerRadius="3"
                                        ClipToBounds="True">
                                    <Panel>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Text="{Binding TypeName}"
                                                   Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    </Panel>
                                </Border>

                                <!-- Checkbox and Type Badge -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding TypeBadgeBrush}"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TypeName}"
                                                   Foreground="White"
                                                   FontSize="9"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Wallpaper Name -->
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" TextTrimming="CharacterEllipsis"/>

                                <!-- Resolution + File Size -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Resolution}" FontSize="9"
                                               Foreground="#888888"
                                               IsVisible="{Binding HasResolution}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileSize}" FontSize="10"
                                               Foreground="#888888"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="10" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="OK" Width="100" Command="{Binding OkCommand}"
                    Background="#0078D4" IsDefault="True"/>
            <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}"
                    Background="#3E3E42"/>
        </StackPanel>
    </Grid>
</Window>

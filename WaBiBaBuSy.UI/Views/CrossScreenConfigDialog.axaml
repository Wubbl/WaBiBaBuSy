<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="WaBiBaBuSy.UI.Views.CrossScreenConfigDialog"
        x:DataType="vm:CrossScreenConfigViewModel"
        Icon="/Assets/BiBaBuColorIcon.ico"
        Title="Animation Configuration"
        Width="600" Height="750" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Design.DataContext>
        <vm:CrossScreenConfigViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Animation Configuration"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Configuration Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
            <StackPanel Spacing="15">

                <!-- Background Configuration -->
                <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Background Layer" FontSize="14" FontWeight="SemiBold"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Mode:" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding BackgroundModeIndex}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Solid Color"/>
                                <ComboBoxItem Content="Stretched Image"/>
                                <ComboBoxItem Content="Tiled Image"/>
                                <ComboBoxItem Content="Three Zone (Corridor)"/>
                                <ComboBoxItem Content="Icon Zone (Auto-detect)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding IsSolidColorMode}">
                            <TextBlock Text="Color (Hex):" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding BackgroundColor}" Width="150" Watermark="#000000"/>
                                <Button Content="Auto-detect" Command="{Binding AutoDetectBackgroundColorCommand}"
                                        Padding="8,4" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding IsImageMode}">
                            <TextBlock Text="Background Image:" FontSize="12"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding BackgroundImagePath}" IsReadOnly="True" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Browse File..." Command="{Binding BrowseBackgroundImageCommand}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsThreeZoneMode}">
                            <TextBlock Text="Three Zone Settings" FontSize="12" FontWeight="SemiBold"/>

                            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Corridor Top (px):" FontSize="12" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding CorridorTopPx}"
                                               Minimum="0" Maximum="2000" Increment="10" Width="140" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Corridor Height (px):" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CorridorHeightPx}"
                                               Minimum="50" Maximum="2000" Increment="10" Width="140" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Top Zone Color:" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <TextBox Text="{Binding TopZoneColorHex}" Width="110" Watermark="#1A3A5C"/>
                                    <Border Width="20" Height="20" CornerRadius="3" Background="{Binding TopZoneColorHex}" BorderBrush="#555" BorderThickness="1" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bottom Zone Color:" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <TextBox Text="{Binding BottomZoneColorHex}" Width="110" Watermark="#3C1A5C"/>
                                    <Border Width="20" Height="20" CornerRadius="3" Background="{Binding BottomZoneColorHex}" BorderBrush="#555" BorderThickness="1" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Corridor Color:" FontSize="12" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                    <TextBox Text="{Binding CorridorColorHex}" Width="110" Watermark="#1E1E1E"/>
                                    <Border Width="20" Height="20" CornerRadius="3" Background="{Binding CorridorColorHex}" BorderBrush="#555" BorderThickness="1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Place icons in the top/bottom zones. The animation travels through the center corridor."
                                       FontSize="10" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Icon Zone Settings -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsIconZoneMode}">
                            <TextBlock Text="Icon Zone Settings" FontSize="12" FontWeight="SemiBold"/>

                            <!-- Corridor color -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Corridor Color (free bands):" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox Text="{Binding IconCorridorColorHex}" Width="110" Height="26" Watermark="#1E1E1E"/>
                                    <Border Width="26" Height="26" CornerRadius="3"
                                            Background="{Binding IconCorridorColorHex}"
                                            BorderBrush="#555" BorderThickness="1" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Zone color palette -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Zone Colors (icon clusters):" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="Randomize" Command="{Binding RandomizePaletteCommand}"
                                            Height="26" Padding="8,3" FontSize="11" VerticalContentAlignment="Center"/>
                                    <Button Content="+" Command="{Binding AddZoneColorCommand}"
                                            Height="26" Padding="8,3" FontSize="11" ToolTip.Tip="Add zone color" VerticalContentAlignment="Center"/>
                                    <Button Content="−" Command="{Binding RemoveLastZoneColorCommand}"
                                            Height="26" Padding="8,3" FontSize="11" ToolTip.Tip="Remove last zone color" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding IconZonePalette}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="2" Margin="0,0,6,4" Width="50">
                                                <Border Width="46" Height="28" CornerRadius="3"
                                                        Background="{Binding ColorHex}"
                                                        BorderBrush="#555" BorderThickness="1"/>
                                                <TextBox Text="{Binding ColorHex}" FontSize="9" Height="20"
                                                         Padding="2,1" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="Each node automatically detects its own desktop icon positions at startup. Adjacent icons (horizontal and vertical) merge into one cluster. The animation weaves through all free areas between clusters."
                                       FontSize="10" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Animation Configuration -->
                <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Animation Layer" FontSize="14" FontWeight="SemiBold"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Animation File:" FontSize="12"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding AnimationPath}" IsReadOnly="True" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Select from Gallery" Command="{Binding SelectAnimationFromGalleryCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- F4: Multiple source images — placed next to Animation File -->
                        <Expander Header="Multiple Source Images" IsExpanded="False" Margin="0,4,0,8">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap"
                                           Text="The first image above is the primary source. Add more here for multi-image patterns or per-image scattering."/>
                                <ItemsControl ItemsSource="{Binding AdditionalAnimationPaths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBox Grid.Column="0" Text="{Binding}" IsReadOnly="True" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="Remove"
                                                        Command="{Binding $parent[ItemsControl].((vm:CrossScreenConfigViewModel)DataContext).RemoveAdditionalImageCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Add from Gallery" Command="{Binding AddAdditionalImagesFromGalleryCommand}" HorizontalAlignment="Left"/>

                                <StackPanel Spacing="4" Margin="0,8,0,0">
                                    <TextBlock Text="When pattern is OFF and multiple images are listed:" FontSize="11" Foreground="#888888"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Spread (px):" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MultiImageSpread}" Minimum="0" Maximum="1000" Increment="10" HorizontalAlignment="Left" Width="120"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Phase jitter (ms):" VerticalAlignment="Center"/>
                                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MultiImagePhaseJitterMs}" Minimum="0" Maximum="5000" Increment="50" HorizontalAlignment="Left" Width="120"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Fit Mode:" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding FitModeIndex}" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Center (native resolution)"/>
                                <ComboBoxItem Content="Fit (scale into screen)"/>
                                <ComboBoxItem Content="Fill (cover screen)"/>
                                <ComboBoxItem Content="Stretch (distort to screen)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="5" IsVisible="{Binding IsAnimationHeightRelevant}">
                            <TextBlock Text="Animation Height (pixels):" FontSize="12"/>
                            <NumericUpDown Value="{Binding AnimationHeight}"
                                           Minimum="100" Maximum="2160"
                                           Increment="10"
                                           Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Vertical Alignment:" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding VerticalAlignmentIndex}" Width="150" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Top"/>
                                <ComboBoxItem Content="Center"/>
                                <ComboBoxItem Content="Bottom"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding AnimationLoop}" Content="Loop Animation" Margin="0,5,0,0"/>
                        <CheckBox IsChecked="{Binding RotateWithPath}"
                                  Content="Rotate animation with path direction (IconZone only)"
                                  IsEnabled="{Binding IsIconZoneMode}"
                                  Margin="0,2,0,0"/>

                        <CheckBox IsChecked="{Binding IconZonePaletteEnabled}"
                                  Content="Show icon-zone palette (debug colored bands; only in IconZone mode)"
                                  IsEnabled="{Binding IsIconZoneMode}"
                                  Margin="0,2,0,0"/>

                        <!-- F2: Color grading -->
                        <Expander Header="Color Grading" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="Mode:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ColorGradingModeIndex}" Width="220" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Rainbow (tint sweep)"/>
                                        <ComboBoxItem Content="Random Colors"/>
                                        <ComboBoxItem Content="Gradient (ping-pong)"/>
                                        <ComboBoxItem Content="Cycle Color List"/>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding !IsColorGradingNone}">
                                    <TextBlock Grid.Column="0" Text="Cycles per second:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding ColorGradingCyclesPerSecond}" Minimum="0.01" Maximum="10" Increment="0.1" HorizontalAlignment="Left" Width="120"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsColorGradingGradient}">
                                    <TextBlock Grid.Column="0" Text="Color A:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding ColorGradingGradientA}" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="Color B:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="3" Text="{Binding ColorGradingGradientB}" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <StackPanel Spacing="4" IsVisible="{Binding IsColorGradingColorListMode}">
                                    <TextBlock Text="Color list (comma-separated hex):" FontSize="11" Foreground="#888888"/>
                                    <TextBox Text="{Binding ColorGradingColorListCsv}"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding !IsColorGradingNone}">
                                    <TextBlock Grid.Column="0" Text="Seed:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding ColorGradingSeed}" Minimum="0" Maximum="999999" Increment="1" HorizontalAlignment="Left" Width="120"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!-- F3: Pattern multiplier -->
                        <Expander Header="Pattern Multiplier" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <CheckBox IsChecked="{Binding PatternEnabled}"
                                          Content="Enable pattern (tile the animation across the desktop)"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding PatternEnabled}">
                                    <TextBlock Grid.Column="0" Text="Sizing:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PatternSizingIndex}" Width="200" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Fill (auto, edge-to-edge)"/>
                                        <ComboBoxItem Content="Explicit count"/>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsPatternExplicit}">
                                    <TextBlock Grid.Column="0" Text="Count X:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding PatternCountX}" Minimum="1" Maximum="500" Increment="1" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="Count Y:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="3" Value="{Binding PatternCountY}" Minimum="1" Maximum="500" Increment="1" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding PatternEnabled}">
                                    <TextBlock Grid.Column="0" Text="Spacing X (px):" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding PatternSpacingX}" Minimum="0" Maximum="2000" Increment="5" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="Spacing Y (px):" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="3" Value="{Binding PatternSpacingY}" Minimum="0" Maximum="2000" Increment="5" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding PatternEnabled}">
                                    <TextBlock Grid.Column="0" Text="Margin (px):" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding PatternMargin}" Minimum="0" Maximum="500" Increment="10" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="Seed:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="3" Value="{Binding PatternSeed}" Minimum="0" Maximum="999999" Increment="1" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" IsVisible="{Binding PatternEnabled}">
                                    <TextBlock Grid.Column="0" Text="Random offset (px):" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding PatternRandomOffset}" Minimum="0" Maximum="500" Increment="5" Width="100" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="Random rot. (deg):" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="3" Value="{Binding PatternRandomRotation}" Minimum="0" Maximum="180" Increment="5" Width="100" HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock FontSize="10" Foreground="#888888" TextWrapping="Wrap"
                                           IsVisible="{Binding PatternEnabled}"
                                           Text="In Fill mode the pattern auto-tiles edge-to-edge from canvas size, image size, and spacing — the whole grid moves as a unit. With IconZone background, icon-zone rectangles act as a clip mask so user desktop icons stay visible."/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Distribution Mode Configuration -->
                <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Animation Distribution (Phase 3)" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose how animation flows across selected clients:" FontSize="11" Foreground="#AAAAAA"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Mode:" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding AnimationDistributionModeIndex}" Width="250" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Sequential - Animation flows one client to next"/>
                                <ComboBoxItem Content="Simultaneous - All clients animate together"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Sequential: Clients report when rendering starts, next client starts when previous finishes. Simultaneous: All clients start at same time with synchronized timing."
                                   FontSize="10" Foreground="#888888" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Movement Configuration -->
                <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Movement Pattern" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="How the animation moves across screens:" FontSize="11" Foreground="#AAAAAA"/>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Pattern:" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding AvailableMovementOptions}"
                                      SelectedItem="{Binding SelectedMovementType}"
                                      Width="250" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Speed (visible for all non-static types) -->
                        <StackPanel Spacing="5" IsVisible="{Binding IsMovementActive}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="Speed (pixels/second):" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AnimationSpeed}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider Value="{Binding AnimationSpeed}"
                                    Minimum="50" Maximum="2000"
                                    TickFrequency="50"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock Text="Slower ← → Faster" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Direction angle (for Linear/Bounce) -->
                        <StackPanel Spacing="5" IsVisible="{Binding IsDirectionVisible}">
                            <TextBlock Text="Direction (degrees: 0=right, 90=down, 45=diagonal):" FontSize="12"/>
                            <NumericUpDown Value="{Binding MovementAngle}"
                                           Minimum="0" Maximum="360"
                                           Increment="15"
                                           Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Wave params (for SineWave) -->
                        <StackPanel Spacing="5" IsVisible="{Binding IsSineWaveMode}">
                            <TextBlock Text="Wave Amplitude (px):" FontSize="12"/>
                            <NumericUpDown Value="{Binding WaveAmplitude}"
                                           Minimum="50" Maximum="1000"
                                           Increment="25"
                                           Width="150" HorizontalAlignment="Left"/>
                            <TextBlock Text="Wave Frequency (Hz):" FontSize="12"/>
                            <NumericUpDown Value="{Binding WaveFrequency}"
                                           Minimum="0.1" Maximum="5.0"
                                           Increment="0.1"
                                           FormatString="F1"
                                           Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Orbit params (for Circular) -->
                        <StackPanel Spacing="5" IsVisible="{Binding IsCircularMode}">
                            <TextBlock Text="Orbit Radius (px):" FontSize="12"/>
                            <NumericUpDown Value="{Binding OrbitRadius}"
                                           Minimum="100" Maximum="2000"
                                           Increment="50"
                                           Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- RandomWalk controls -->
                        <StackPanel Spacing="8" IsVisible="{Binding IsRandomWalkMode}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Iteration length (steps):" FontSize="12"/>
                                <TextBlock Text="After this many steps the walk pattern changes. 0 = never change." FontSize="10" Foreground="#888888"/>
                                <NumericUpDown Value="{Binding RandomWalkIterationSteps}"
                                               Minimum="0" Maximum="500"
                                               Increment="5"
                                               Width="150" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Text="Movement is deterministic across all monitors (sync maintained)."
                                       FontSize="10" Foreground="#888888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Monitor Selection Configuration -->
                <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Target Monitors" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Select which monitors/clients should display this animation (at least one required):" FontSize="11" Foreground="#AAAAAA" TextWrapping="Wrap"/>

                        <!-- Show monitor list or helpful message if empty -->
                        <Border IsVisible="{Binding !AvailableMonitors.Count}" Background="#3E3E42" CornerRadius="3" Padding="15" Margin="0,5,0,0">
                            <TextBlock Text="No monitors detected. Please ensure the application has detected your local monitors or connected clients."
                                       FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AvailableMonitors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3E3E42" CornerRadius="3" Padding="10" Margin="0,5,0,0">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" FontSize="11"/>
                                                <StackPanel Orientation="Horizontal" Spacing="15">
                                                    <TextBlock Text="{Binding Resolution, StringFormat='Resolution: {0}'}" FontSize="10" Foreground="#CCCCCC"/>
                                                    <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" FontSize="10" Foreground="#CCCCCC"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                                <Button Content="&#9650;" FontSize="10" Padding="6,2"
                                                        Command="{Binding $parent[Window].((vm:CrossScreenConfigViewModel)DataContext).MoveMonitorUpCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Move up in animation order"/>
                                                <Button Content="&#9660;" FontSize="10" Padding="6,2"
                                                        Command="{Binding $parent[Window].((vm:CrossScreenConfigViewModel)DataContext).MoveMonitorDownCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Move down in animation order"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
            <Button Content="OK" Command="{Binding OkCommand}" Width="100"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>

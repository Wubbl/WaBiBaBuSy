<!-- WaBiBaBuSy.UI/Views/PlaylistPanel.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WaBiBaBuSy.UI.ViewModels"
             x:Class="WaBiBaBuSy.UI.Views.PlaylistPanel"
             x:DataType="vm:PlaylistViewModel"
             FontSize="12">
    <UserControl.Styles>
        <!-- Dark selection so the colored chips stay readable on the selected row -->
        <Style Selector="ListBox#ItemsList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#24344A"/>
        </Style>
        <Style Selector="ListBox#ItemsList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2C3E57"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,8,0,0">
        <!-- Picker · New · Save -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <ComboBox ItemsSource="{Binding SavedPlaylists}" SelectedItem="{Binding SelectedSavedPlaylist}"
                      PlaceholderText="Saved playlists" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" Content="New" Command="{Binding NewPlaylistCommand}"/>
            <Button Grid.Column="2" Content="Save" Command="{Binding SavePlaylistCommand}"
                    ToolTip.Tip="Save under the name below (a new name saves a new file)"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
            <TextBlock Text="Name" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding PlaylistName}"/>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,6">
            <WrapPanel>
                <CheckBox Content="Loop" IsChecked="{Binding Loop}" Margin="0,0,12,0"/>
                <CheckBox Content="Shuffle" IsChecked="{Binding Shuffle}" Margin="0,0,12,0"/>
                <TextBlock Text="Default" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip.Tip="Dwell time for every item whose own duration is empty"/>
                <NumericUpDown Value="{Binding DefaultDurationSeconds}" Minimum="1" Maximum="86400" Increment="5" Width="110"/>
                <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBlock Text="Transition" VerticalAlignment="Center" Margin="12,0,6,0"
                           ToolTip.Tip="How items replace each other: Cut, Fade (through black) or Wipe (a boundary runs once around the room). Select an item to override it."/>
                <ComboBox ItemsSource="{Binding TransitionKinds}" SelectedItem="{Binding DefaultTransitionKind}"/>
                <NumericUpDown Value="{Binding DefaultTransitionSeconds}" Minimum="0.2" Maximum="20" Increment="0.5" FormatString="0.0"
                               Width="110" Margin="6,0,0,0" ToolTip.Tip="Transition length in seconds (a Wipe takes this long for the whole room)"/>
                <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <CheckBox Content="Every" IsChecked="{Binding InterruptEnabled}" Margin="12,0,6,0"
                          ToolTip.Tip="Fire a show event on a timer while the show runs (does not change the item)"/>
                <NumericUpDown Value="{Binding InterruptEveryMinutes}" Minimum="1" Maximum="1440" Width="110" IsEnabled="{Binding InterruptEnabled}"/>
                <TextBlock Text="min" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox ItemsSource="{Binding InterruptTypes}" SelectedItem="{Binding InterruptType}" IsEnabled="{Binding InterruptEnabled}"/>
            </WrapPanel>
            <TextBlock Text="{Binding ShowSummary}" Opacity="0.75" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Items: drag ≡ to reorder, right-click for Duplicate / Remove, click to load into the Scene tab -->
        <Grid Grid.Row="3">
            <ListBox Name="ItemsList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistItemRow">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Background="Transparent" Margin="0,2">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Duplicate"
                                              Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).DuplicateItemCommand}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Remove"
                                              Command="{Binding $parent[ListBox].((vm:PlaylistViewModel)DataContext).RemoveItemCommand}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Grid.Column="0" Text="≡" FontSize="16" VerticalAlignment="Center" Cursor="SizeNorthSouth"
                                       Foreground="#888888" PointerPressed="OnHandlePressed" ToolTip.Tip="Drag to reorder"/>
                            <!-- 16:9 thumbnail on the scene's background color; green frame = on the wall now -->
                            <Border Grid.Column="1" Width="96" Height="54" CornerRadius="4" Background="{Binding SceneBackground}"
                                    BorderBrush="#00CC66" BorderThickness="{Binding PlayingFrame}"
                                    ClipToBounds="True" VerticalAlignment="Top">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="▶ " Foreground="#00CC66" FontWeight="Bold" VerticalAlignment="Center" IsVisible="{Binding IsPlaying}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Item name" FontWeight="SemiBold"
                                             HorizontalAlignment="Stretch"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Chips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SceneChip">
                                            <Border Background="{Binding Background}" CornerRadius="8" Padding="6,1" Margin="0,0,4,3"
                                                    ToolTip.Tip="{Binding Tip}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding Foreground}" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="11" VerticalAlignment="Center"
                                                               MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Per-item overrides: only on the selected row -->
                                <WrapPanel IsVisible="{Binding $parent[ListBoxItem].IsSelected}">
                                    <TextBlock Text="Comes in with" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{x:Static vm:SceneGlyphs.Transition}"/>
                                    <ComboBox ItemsSource="{x:Static vm:PlaylistItemRow.TransitionChoices}" SelectedItem="{Binding TransitionChoice}"
                                              FontSize="11" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding TransitionSecondsText}" PlaceholderText="1.5" Width="56" FontSize="11" Margin="0,0,12,0"
                                             ToolTip.Tip="Seconds (blank = 1.5). Ignored for Playlist default and Cut."/>
                                    <CheckBox Content="Lap-snap" IsChecked="{Binding SnapToLap}" FontSize="11"
                                              ToolTip.Tip="Round the duration up to whole movement laps, so the switch comes when the sprite is back where it started (Linear / SineWave lap, Bounce round trip, Circular orbit; Static, Random walk and the IconZone path switch on time)."/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2" Width="72" VerticalAlignment="Top">
                                <TextBox Text="{Binding DurationText}" PlaceholderText="default" HorizontalContentAlignment="Right"
                                         ToolTip.Tip="Seconds. Empty = the playlist default."/>
                                <TextBlock Text="{Binding DurationSummary}" FontSize="10" Opacity="0.7" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas IsHitTestVisible="False">
                <Rectangle Name="DropMarker" Height="3" Fill="#0078D4" IsVisible="False"/>
            </Canvas>
        </Grid>

        <StackPanel Grid.Row="4">
            <Button Content="＋ Add ▾" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,6,0,0" ToolTip.Tip="Append the Scene editor's draft or a preset as a new item">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Current scene" Command="{Binding AddCurrentSceneCommand}"/>
                        <MenuItem Header="From preset" ItemsSource="{Binding PresetEntries}" IsEnabled="{Binding HasPresets}">
                            <MenuItem.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:PresetMenuEntry">
                                    <Setter Property="Header" Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding Command}"/>
                                </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                        </MenuItem>
                        <MenuItem Header="Auto from folder…" Command="{Binding AddFromFolderCommand}"
                                  ToolTip.Tip="Build varied items from every picture, GIF and video in a folder (appended to this playlist)"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <TextBlock Text="{Binding FolderStatus}" IsVisible="{Binding HasFolderStatus}"
                       FontSize="11" Foreground="#9FC5FF" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>

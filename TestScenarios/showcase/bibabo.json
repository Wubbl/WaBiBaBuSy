{
  // BiBaBo (design 2026-10-21-bibabo-bomb-game-design.md): a seeded game on this machine's monitors (every monitor
  // a seat in test runs), exact frames through the intro, the countdown with the riddle cards, then BOOM; a second
  // game ends DEFUSED. The waits give the players time to render the text sprites before the exact frames.
  "name": "bibabo",
  "requires": { "minRemoteNodes": 0 },
  "steps": [
    { "type": "testMode", "timecode": false },
    { "type": "playScene", "label": "scene", "scene": "scenes/02-dvd-bounce.json" },

    { "type": "showEvent", "label": "bomb", "atElapsedMs": 1000, "event": { "type": "Bomb", "seed": 7 } },
    { "type": "wait", "label": "text sprites", "ms": 3000 },
    { "type": "exactFrame", "label": "roulette t=+2.5s", "elapsedMs": 3500 },
    { "type": "exactFrame", "label": "drop + cables t=+6.5s", "elapsedMs": 7500 },
    { "type": "exactFrame", "label": "countdown + cards t=+20s", "elapsedMs": 21000 },
    { "type": "exactFrame", "label": "last 30 s t=+4:50", "elapsedMs": 291000 },

    { "type": "showEvent", "label": "boom", "atElapsedMs": 30000, "event": { "type": "BombOutcome" }, "bombOutcome": "WrongCable" },
    { "type": "wait", "label": "text sprites", "ms": 2000 },
    { "type": "exactFrame", "label": "BOOM t=+0.5s", "elapsedMs": 30500 },
    { "type": "exactFrame", "label": "BOOM t=+2s", "elapsedMs": 32000 },

    { "type": "showEvent", "label": "bomb 2", "atElapsedMs": 45000, "event": { "type": "Bomb", "seed": 2026 } },
    { "type": "showEvent", "label": "defused", "atElapsedMs": 120000, "event": { "type": "BombOutcome" }, "bombOutcome": "Defused" },
    { "type": "wait", "label": "text sprites", "ms": 3000 },
    { "type": "exactFrame", "label": "bomb 2 countdown", "elapsedMs": 80000 },
    { "type": "exactFrame", "label": "DEFUSED t=+2s", "elapsedMs": 122000 },

    { "type": "stop" }
  ]
}
